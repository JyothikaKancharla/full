/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

/* BODY */
body {
  background: #f5f6fa;
  color: #333;
}

/* SIDEBAR */
.sidebar {
  width: 220px;
  height: 100vh;
  background: #2f3640;
  color: white;
  position: fixed;
  padding: 20px;
}

.sidebar-brand {
  font-size: 20px;
  margin-bottom: 30px;
  font-weight: bold;
}

.nav-item {
  display: block;
  padding: 10px;
  margin-bottom: 10px;
  color: white;
  text-decoration: none;
  cursor: pointer;
  border-radius: 5px;
}

.nav-item:hover,
.nav-item.active {
  background: #40739e;
}

/* MAIN */
.main-shell {
  margin-left: 220px;
}

/* TOP BAR */
.top-bar {
  background: white;
  padding: 15px 25px;
  border-bottom: 1px solid #ddd;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* CONTENT */
.content-area {
  padding: 30px;
  max-width: 1100px;
}

/* SECTION VISIBILITY */
.page-section {
  display: none;
}

.page-section.active {
  display: block;
}

/* HEADINGS */
h2 {
  margin-bottom: 5px;
}

.section-sub {
  margin-bottom: 20px;
  color: #777;
}

/* CARDS */
.stats-grid {
  display: flex;
  gap: 15px;
  margin-bottom: 25px;
}

.stat-card {
  background: white;
  padding: 20px;
  flex: 1;
  border-radius: 8px;
  border: 1px solid #ddd;
  text-align: center;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.stat-value {
  font-size: 24px;
  font-weight: bold;
  display: block;
  margin-bottom: 5px;
}

.stat-label {
  font-size: 14px;
  color: #777;
}

/* CONTROLS */
.controls-bar {
  display: flex;
  gap: 10px;
  margin-bottom: 15px;
  align-items: center;
}

.search-field {
  width: 250px;
}

/* TABLE */
.table-shell {
  background: white;
  padding: 20px;
  border-radius: 8px;
  margin-top: 20px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th {
  background: #f1f2f6;
}

th, td {
  padding: 10px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}

/* BUTTONS */
button {
  padding: 8px 12px;
  border: none;
  background: #40739e;
  color: white;
  cursor: pointer;
  border-radius: 4px;
  margin-top: 5px;
}

button:hover {
  background: #273c75;
}

/* INPUT */
input, select {
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

/* MODAL */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: none;
  justify-content: center;
  align-items: center;
}

.modal-overlay.open {
  display: flex;
}

.modal-box {
  background: white;
  padding: 20px;
  border-radius: 8px;
  width: 400px;
}

/* FORM */
.field-group {
  margin-bottom: 12px;
}

.field-group label {
  display: block;
  margin-bottom: 5px;
  font-size: 14px;
}

/* EMPTY STATE */
.empty-state {
  text-align: center;
  padding: 30px;
  color: #777;
}